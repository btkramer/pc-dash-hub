HA_URL=http://homeassistant.local:8123
HA_TOKEN=replace-with-long-lived-access-token
HA_LIGHT_ENTITY=light.office_desklight

# Directory where per-device settings JSON files are stored. Relative paths
# resolve against the process's working directory.
DATA_DIR=data

# Optional. When set, every request except /health must send
# "Authorization: Bearer <HUB_TOKEN>". Off by default: the knob, pc-dash-app
# and the phone deck don't send a token yet, so leave this unset for now.
# HUB_TOKEN=
